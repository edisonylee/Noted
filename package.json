{
  "name": "noted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ios": "tsc && vite build --config vite.mobile.config.ts",
    "dev:ios": "vite --config vite.mobile.config.ts",
    "ios:check": "bun run build:ios && node --test tests/ios-shell.test.mjs",
    "build:diarizer": "bash scripts/build-fluidaudio-helper.sh",
    "build:desktop": "bun run build && bun run build:diarizer",
    "build:alpha": "VITE_NOTED_PROFILE=alpha bun run build",
    "alpha:check": "bun run build:alpha && node --test tests/alpha-build.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:ios:build": "tauri ios build --config src-tauri/tauri.ios.conf.json",
    "tauri:ios:dev": "tauri ios dev --config src-tauri/tauri.ios.conf.json",
    "tauri:alpha": "NOTED_RELEASE_PROFILE=alpha VITE_NOTED_PROFILE=alpha tauri build --config src-tauri/tauri.alpha.conf.json",
    "app:update": "bash scripts/install-app.sh",
    "app:update:if-needed": "bash scripts/update-app-if-needed.sh",
    "team:serve": "bun services/team/server.ts",
    "team:local": "bun scripts/team-local.ts",
    "team:mcp": "bun services/team/mcp.ts",
    "team:test": "bun test services/team/server.test.ts",
    "team:preview": "vite --config vite.team.config.ts",
    "team:demo": "bun scripts/team-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-list": "^3.27.3",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extensions": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "10.1.0",
    "recharts": "^3.8.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
