{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window + the record-prompt popup",
  "platforms": ["macOS"],
  "windows": ["main", "record-prompt"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$DOCUMENT/Notes/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    }
  ]
}
