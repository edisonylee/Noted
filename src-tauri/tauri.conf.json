{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noted",
  "version": "0.1.0",
  "identifier": "com.noted.app",
  "build": {
    "beforeDevCommand": "bun run build:diarizer && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "noted",
        "width": 920,
        "height": 760,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/meetings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["resources/*"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
