{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noted",
  "identifier": "com.noted.iphone",
  "build": {
    "beforeDevCommand": "bun run dev:ios",
    "beforeBuildCommand": "bun run build:ios",
    "frontendDist": "../dist-ios"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["noted"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "iOS": {
      "developmentTeam": "MYGAYC672C"
    },
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
